        <mxCell id="c1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=34;fontColor=#0F172A;fontStyle=1;spacing=0;" value="One round, from the brief to a verdict" vertex="1"><mxGeometry x="30" y="18" width="1440" height="44" as="geometry" /></mxCell>
