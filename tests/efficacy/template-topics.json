{
  "templates": [
    {"id": "base-quality", "path": "templates/core/quality.md",
     "globs": []},
    {"id": "base-git", "path": "templates/core/git.md",
     "globs": ["**/.gitignore", "**/.gitattributes", "**/.github/**",
               "**/.pre-commit-config.yaml"]},
    {"id": "base-docs", "path": "templates/core/docs.md",
     "globs": ["**/*.md", "**/*.rst", "**/docs/**"]},
    {"id": "base-testing", "path": "templates/core/testing.md",
     "globs": ["**/tests/**", "**/test_*.py", "**/*_test.py",
               "**/conftest.py"]},
    {"id": "base-review", "path": "templates/core/review.md",
     "globs": []},
    {"id": "backend-http", "path": "templates/backend/http.md",
     "globs": ["**/app.py", "**/wsgi.py", "**/routes.py", "**/routes/**",
               "**/views.py", "**/views/**", "**/handlers*.py",
               "**/web/__init__.py", "**/webapp/__init__.py"]},
    {"id": "backend-api", "path": "templates/backend/api.md",
     "globs": ["**/api.py", "**/api/**", "**/openapi.*", "**/export*.py"]},
    {"id": "base-security", "path": "templates/security/security.md",
     "globs": ["**/security*.py", "**/csrf*.py", "**/forms*.py",
               "**/validat*.py", "**/sanitiz*.py"]},
    {"id": "backend-auth", "path": "templates/backend/auth.md",
     "globs": ["**/auth*.py", "**/*login*", "**/sign_in*", "**/signin*",
               "**/session*.py", "**/users.py", "**/passwords.py"]},
    {"id": "backend-database", "path": "templates/backend/database.md",
     "globs": ["**/db.py", "**/db/**", "**/database*.py", "**/repo.py",
               "**/repository*.py", "**/repositories/**", "**/store*.py",
               "**/storage*.py", "**/migrations/**", "**/*.sql"]},
    {"id": "frontend-ux", "path": "templates/frontend/ux.md",
     "globs": ["**/*.html", "**/*.css", "**/*.js", "**/static/**"]},
    {"id": "base-data-modeling", "path": "templates/data/data-modeling.md",
     "globs": ["**/models.py", "**/models/**", "**/schema*",
               "**/entities*.py", "**/domain*.py"]},
    {"id": "base-data-governance",
     "path": "templates/data/data-governance.md",
     "globs": ["**/*gdpr*", "**/*privacy*", "**/*erasure*", "**/*erase*",
               "**/*retention*", "**/*personal*", "**/*audit*"]}
  ]
}
